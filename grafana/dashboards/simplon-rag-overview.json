{
  "title": "Simplon RAG Overview",
  "uid": "simplon-rag-overview",
  "timezone": "browser",
  "refresh": "15s",
  "schemaVersion": 38,
  "panels": [


    {
      "id": 1,
      "title": "Requêtes / seconde par endpoint",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{endpoint}} {{status}}"
        }
      ]
    },

    {
      "id": 2,
      "title": "Taux d'erreurs 5xx (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(http_requests_total{status=~\"5..\"}[5m]) / rate(http_requests_total[5m]) * 100",
          "legendFormat": "Erreurs 5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 10, "color": "red" }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "title": "Latence /messages — p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{endpoint=~\".*messages.*\"}[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{endpoint=~\".*messages.*\"}[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{endpoint=~\".*messages.*\"}[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 60, "color": "red" }
            ]
          }
        }
      }
    },


    {
      "id": 4,
      "title": "Décisions agent — guard_route",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(rag_agent_decisions_total{node=\"guard_route\"}[5m])",
          "legendFormat": "{{decision}}"
        }
      ]
    },

    {
      "id": 5,
      "title": "Taux d'escalade — nœud evaluate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(rag_agent_decisions_total{node=\"evaluate\"}[5m])",
          "legendFormat": "{{decision}}"
        }
      ]
    },

    {
      "id": 6,
      "title": "Chunks récupérés (total cumulé)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "rag_retrieved_chunks_total",
          "legendFormat": "Chunks"
        }
      ]
    },


    {
      "id": 7,
      "title": "Logs API — flux temps réel",
      "type": "logs",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 10 },
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{job=\"simplon-rag\"}",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    }

  ]
}