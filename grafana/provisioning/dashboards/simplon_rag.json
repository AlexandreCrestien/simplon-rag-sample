  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "🔴 PANELS RED PAR ENDPOINT",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Volume de Requêtes (Rate - 5m)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(http_requests_total[5m])) by (endpoint, method)",
          "legendFormat": "{{method}} {{endpoint}}"
        }
      ]
    },
    {
      "title": "Taux d'Erreurs HTTP (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) or vector(0) / sum(rate(http_requests_total[5m])) * 100",
          "legendFormat": "Erreurs 5xx"
        }
      ]
    },
    {
      "title": "Latence des requêtes (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p50 {{endpoint}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p95 {{endpoint}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p99 {{endpoint}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "🤖 PANEL AGENT & LANGGRAPH",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }
    },
    {
      "title": "Décisions de l'Agent (Escalades / Routage)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(rag_agent_decisions_total[5m])) by (decision, node)",
          "legendFormat": "{{node}} -> {{decision}}"
        }
      ]
    },
    {
      "title": "Score Moyen d'Évaluation du Chatbot",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "green", "value": 8 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(rag_eval_score_sum[5m])) / sum(rate(rag_eval_score_count[5m]))",
          "legendFormat": "Score Moyen (RAG)"
        }
      ]
    },
    {
      "title": "Latence Interne par Nœud LangGraph (p95)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(rag_node_latency_seconds_bucket[5m])) by (le, node_name))",
          "legendFormat": "p95 {{node_name}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "📂 PANEL INGESTION & RETRIEVAL",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "title": "Appels à l'Endpoint d'Ingestion",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(http_requests_total{endpoint=\"/api/v1/documents/ingest\"}[5m]))",
          "legendFormat": "Appels Ingest"
        }
      ]
    },
    {
      "title": "Volume de Chunks Récupérés (Retrieval)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(rag_retrieved_chunks_total[5m]))",
          "legendFormat": "Chunks Récupérés"
        }
      ]
    }
  ],
